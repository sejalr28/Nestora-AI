# --- Database ---
# Local dev (docker-compose): matches the postgres service below.
# When you migrate to Supabase later, just swap this one value.
DATABASE_URL=postgresql://societyboard:societyboard@localhost:5432/societyboard

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- LLM provider (modular: switch without touching code) ---
# Options: "ollama" | "claude" | "openai" | "gemini"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Filled in later when you add paid providers — safe to leave blank for now.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Twilio WhatsApp Sandbox (Step 4) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
